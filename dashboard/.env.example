# ── Robinhood Chain / Arbitrum Sepolia RPC ───────────────────
# RPC endpoint to interact with the chain.
# For Arbitrum Sepolia, get a key from:
# - Alchemy: https://dashboard.alchemy.com/
# - QuickNode: https://www.quicknode.com/
# - Or use a public RPC: https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ── Contract Addresses ───────────────────────────────────────
# Deployed Solidity vault contract address.
# Deployed after running the `./scripts/deploy.sh` script or manual Forge deploy.
NEXT_PUBLIC_VAULT_ADDRESS=0x_your_vault_address_here

# Deployed Rust/Stylus Risk Engine contract address.
# Deployed after running the `./scripts/deploy.sh` script or cargo-stylus deploy.
NEXT_PUBLIC_RISK_ENGINE_ADDRESS=0x_your_risk_engine_address_here
