# AegisVault Agent Environment
# Copy this to .env and fill in values

# Robinhood Chain RPC
RPC_URL=https://testnet-rpc.chain.robinhood.com/

# Agent's private key (EOA that proposes trades)
AGENT_PRIVATE_KEY=0x...

# Deployed contract addresses
VETO_VAULT_ADDRESS=0x...
RISK_ENGINE_ADDRESS=0x...

# CoinGecko API (free tier, no key needed for basic)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# OpenAI (for LangChain agent reasoning)
OPENAI_API_KEY=sk-...

# Demo mode (uses mock prices instead of live API)
DEMO_MODE=true
