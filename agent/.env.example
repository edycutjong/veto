# ── Agent Mode ───────────────────────────────────────────────
# Set to "true" for demo mode (mock prices), "false" for live trading
DEMO_MODE=true

# ── Chain RPC ────────────────────────────────────────────────
# RPC endpoint for the target chain (Arbitrum Sepolia for current deployment)
# Arbitrum Sepolia: https://arb-sepolia.g.alchemy.com/v2/<key>
# Robinhood Chain:  https://rpc.testnet.chain.robinhood.com
RPC_URL=https://arb-sepolia.g.alchemy.com/v2/<your-alchemy-key>

# ── Contract Addresses ───────────────────────────────────────
# Deploy via Foundry (forge) and cargo-stylus, then paste addresses here
VETO_VAULT_ADDRESS=0x_your_vault_address_here
RISK_ENGINE_ADDRESS=0x_your_risk_engine_address_here

# ── Agent Wallet ─────────────────────────────────────────────
# Private key of the agent wallet (DO NOT commit real keys!)
# Generate: cast wallet new
AGENT_PRIVATE_KEY=0x_your_private_key_here

# ── Price Data ───────────────────────────────────────────────
# CoinGecko API (free tier, no key needed for demo)
# Get from: https://www.coingecko.com/en/api
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ── Server & Daemon Configuration ────────────────────────────
# Interval in seconds for the background agent to run checks.
# Set to 0 to run once and exit, or a positive integer (e.g. 60) for a daemon loop.
LOOP_INTERVAL=0

# Port for the FastAPI monitoring server to listen on
PORT=8080

